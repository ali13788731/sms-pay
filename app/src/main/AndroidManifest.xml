<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اینترنت فقط برای بررسی نسخه‌ی جدید (خواندن یک فایل کوچک)؛ هیچ داده‌ای از گوشی ارسال نمی‌شود -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- اعلان‌های یادآوری اشتراک و «تازه‌های نسخه‌ی جدید» (اندروید ۱۳ به بعد) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ادامه‌ی بررسی دوره‌ی نسخه و بررسی اشتراک بعد از روشن‌شدن مجدد گوشی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- اختیاری: فقط برای انتخاب/پیشنهاد شماره از مخاطبین و فرستنده‌های صندوق پیامک -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- پرداخت درون‌برنامه‌ای کافه‌بازار (اشتراک)؛ پرداخت کامل داخل خود بازار انجام می‌شود -->
    <uses-permission android:name="com.farsitel.bazaar.permission.PAY_THROUGH_BAZAAR" />

    <!-- از اندروید ۱۱ به بعد برای دیدن/اتصال به برنامه‌ی بازار لازم است -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
    </queries>

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsForwarder">

        <!-- صفحه‌ی شروع (لوگوی انیمیشنی)؛ فقط با اجرای تازه‌ی برنامه نمایش داده می‌شود -->
        <activity
            android:name=".SplashActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.SmsForwarder.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- پنجره‌ی بروزرسانی اجباری -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SmsForwarder.Splash" />

        <!-- اشتراک من: وضعیت، جزئیات، تاریخچه و خرید از طریق بازار -->
        <activity
            android:name=".SubscriptionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RuleActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- نتیجه‌ی ارسال هر پیامک؛ فقط داخل خود برنامه فراخوانی می‌شود -->
        <receiver
            android:name=".SentReceiver"
            android:exported="false" />

        <!-- بررسی دوره‌ای نسخه در پس‌زمینه -->
        <service
            android:name=".UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- تازه‌های نسخه‌ی جدید و اعلان‌های دوره‌ای (حداکثر چند روز یک‌بار) -->
        <service
            android:name=".NewsJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- بررسی دوره‌ای وضعیت اشتراک در بازار + یادآوری پایان اشتراک -->
        <service
            android:name=".LicenseJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
