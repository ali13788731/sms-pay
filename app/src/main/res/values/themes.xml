<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SmsForwarder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- فونت وزیرمتن در سراسر برنامه -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.Label</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.Popup</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.Popup</item>
    </style>

    <!-- صفحه‌ی شروع و صفحه‌ی بروزرسانی: پس‌زمینه‌ی گرادیان از همان لحظه‌ی اول -->
    <style name="Theme.SmsForwarder.Splash" parent="Theme.SmsForwarder">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- نوع‌نمایی (Typography) -->

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/vazirmatn_medium</item>
        <item name="fontFamily">@font/vazirmatn_medium</item>
    </style>

    <style name="TextAppearance.App.Popup" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <!-- استایل‌های مورد استفاده در layout -->

    <style name="TextAppearance.App.Section" parent="TextAppearance.App.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="fontFamily">@font/vazirmatn_bold</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.App.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.App.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.FieldLabel" parent="TextAppearance.App.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.App.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="fontFamily">@font/vazirmatn_bold</item>
    </style>

    <!-- ویجت‌ها -->

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- پنجره‌های برنامه: گوشه‌ی گرد بزرگ و راست‌چین (محتوای هر پنجره خودش layoutDirection=rtl دارد) -->
    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Dialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.App.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/vazirmatn_bold</item>
        <item name="fontFamily">@font/vazirmatn_bold</item>
    </style>

    <style name="TextAppearance.App.OnHero" parent="TextAppearance.App.Body">
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.App.Button.Premium" parent="Widget.App.Button">
        <item name="backgroundTint">@color/premium</item>
        <item name="android:textColor">@color/on_premium</item>
        <item name="iconTint">@color/on_premium</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter" />

    <style name="Widget.App.Chip.Var" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Preview" parent="">
        <item name="android:background">@drawable/bg_preview</item>
        <item name="android:padding">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Body</item>
        <item name="android:textDirection">anyRtl</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
